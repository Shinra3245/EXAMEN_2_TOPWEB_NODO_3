NODE_ENV=development
PORT=3003
DATABASE_URL=postgresql://atm_local:CHANGE_ME@127.0.0.1:55434/atm_local
LOCAL_DATABASE_PASSWORD=CHANGE_ME
BANCO_CENTRAL_URL=http://127.0.0.1:4001/api
# También acepta el origen HTTPS de NODE1; se normaliza a un solo sufijo /api.
# API Key inicial opcional. También puede registrarse en el panel protegido.
BANCO_CENTRAL_API_KEY=
CENTRAL_TIMEOUT_MS=10000
ADMIN_USERNAME=tecnico
# Generar con npm run setup:local; formato scrypt:<salt hexadecimal>:<hash hexadecimal>
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# 32 bytes en hexadecimal; mantener la misma clave para descifrar la API Key guardada.
CONFIG_ENCRYPTION_KEY=
# Exclusivamente para el banco central simulado de desarrollo.
MOCK_CENTRAL_API_KEY=
